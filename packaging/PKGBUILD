# Maintainer: Sabrina <sabrina@localhost>
# Empaqueta aur-guard (daemon efimero + gancho paru).
# Uso: ejecutar packaging/mktarball.sh y luego `makepkg -i` en el directorio generado.

pkgname=aur-guard
pkgver=0.1.0
pkgrel=1
pkgdesc="Monitor de malware AUR + auditoria de host (daemon efimero + gancho paru)"
arch=('x86_64')
url="https://github.com/pansususu/Aur-Guard"
license=('0BSD')
depends=('paru')
optdepends=('libnotify: alertas desktop con notify-send'
            'iproute2: deteccion de puertos escuchando (ss)'
            'iptables: auditoria de reglas de firewall')
makedepends=('rust' 'cargo' 'openssl' 'pkg-config')
options=('!strip')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo build --release --locked --offline
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/aur-guard "$pkgdir/usr/bin/aur-guard"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/aur-guard-check.service "$pkgdir/usr/lib/systemd/user/aur-guard-check.service"
  install -Dm644 packaging/aur-guard-check.timer "$pkgdir/usr/lib/systemd/user/aur-guard-check.timer"
}
